#!/bin/sh
# 提交前做完整性检查，防止被注入的代码（如 2026-08 的 PowerShell 下载器）被提交、推送到服务器。
# 启用：git config core.hooksPath tools/hooks
root=$(git rev-parse --show-toplevel)
for py in "$root/.venv/Scripts/python.exe" "$root/.venv/bin/python" python3 python; do
    if command -v "$py" >/dev/null 2>&1; then
        exec "$py" "$root/tools/check_integrity.py" "$root"
    fi
done
echo "pre-commit: 找不到 Python，跳过完整性检查" >&2
